<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dev.command-center.inventory</string>
  <key>UserName</key><string>_ccinventory</string>
  <key>ProgramArguments</key><array>
    <string>/usr/local/libexec/command-center-inventory</string><string>sync</string>
    <string>--config</string><string>/Library/Application Support/CommandCenterInventory/reporting.toml</string>
  </array>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>Umask</key><integer>63</integer>
  <key>EnvironmentVariables</key><dict><key>HOME</key><string>/var/empty</string></dict>
</dict></plist>
